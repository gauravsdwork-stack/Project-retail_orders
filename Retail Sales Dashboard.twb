  <worksheets>
    <worksheet name='Finding which sub category has highest growth by profit in 2023 compared to 2023'>
      <layout-options>
        <title>
          <formatted-text>
            <run>Finding which sub category has highest growth by profit in 2023 compared to 2023</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='127.0.0.1' name='federated.0406is51r6scfy14fbnyv0y65yac' />
          </datasources>
          <datasource-dependencies datasource='federated.0406is51r6scfy14fbnyv0y65yac'>
            <column caption='Profit Growth 2023 vs 2022' datatype='real' name='[Calculation_0382416940089344]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF YEAR([order_date]) = 2023 THEN [profit] ELSE 0 END) - SUM(IF YEAR([order_date]) = 2022 THEN [profit] ELSE 0 END)' />
            </column>
            <column-instance column='[sub_category]' derivation='None' name='[none:sub_category:nk]' pivot='key' type='nominal' />
            <column caption='Order Date' datatype='datetime' name='[order_date]' role='dimension' type='ordinal' />
            <column caption='Profit' datatype='real' name='[profit]' role='measure' type='quantitative' />
            <column caption='Sub Category' datatype='string' name='[sub_category]' role='dimension' type='nominal' />
            <column-instance column='[Calculation_0382416940089344]' derivation='User' name='[usr:Calculation_0382416940089344:qk]' pivot='key' type='quantitative' />
          </datasource-dependencies>
