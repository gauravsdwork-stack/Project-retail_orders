      <aliases enabled='yes' />
      <column caption='Profit Growth 2023 vs 2022' datatype='real' name='[Calculation_0382416940089344]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF YEAR([order_date]) = 2023 THEN [profit] ELSE 0 END) - SUM(IF YEAR([order_date]) = 2022 THEN [profit] ELSE 0 END)' />
      </column>
      <column caption='Top 5' datatype='integer' name='[Calculation_1957741493383168]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='RANK(SUM([sale_price]), &apos;desc&apos;)'>
          <table-calc ordering-field='[federated.0406is51r6scfy14fbnyv0y65yac].[product_id]' ordering-type='Field' />
        </calculation>
      </column>
      <column caption='Profit in 2022' datatype='real' name='[Calculation_1957741518155780]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(&#13;&#10;    IF YEAR([order_date]) = 2022 THEN [profit]&#13;&#10;    ELSE 0&#13;&#10;    END&#13;&#10;)' />
      </column>
      <column caption='Profit 2023' datatype='real' name='[Calculation_1957741518319621]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(&#13;&#10;    IF YEAR([order_date]) = 2023 THEN [profit]&#13;&#10;    ELSE 0&#13;&#10;    END&#13;&#10;)' />
      </column>
